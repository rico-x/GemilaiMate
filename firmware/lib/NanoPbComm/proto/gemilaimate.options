# nanopb code-generation options for the GemilaiMate protocol.
# Keys are package-qualified because gemilaimate.proto declares `package gemilaimate`.

# Container frame: cap how many payloads ride in a single datagram. Realistic
# batches (boiler + pump + valve + alt) need 4; 6 leaves headroom while keeping
# the statically-allocated Payload[] small.
gemilaimate.Frame.payloads max_count:6

# Per-boiler readings inside SensorData (one today; room for multi-boiler).
gemilaimate.SensorData.boilers max_count:4

# LED channels driven in one LedControl message (PCA9634 has 8 outputs).
gemilaimate.LedControl.channels max_count:8

# Keep the system-info strings short so the Payload union (sized to its largest
# member) stays compact -- every batched Payload slot pays for this.
gemilaimate.SystemInfo.hardware max_size:40
gemilaimate.SystemInfo.version max_size:24

gemilaimate.Capabilities.addons max_count:4
